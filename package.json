{
  "name": "perspective-dieline-generator",
  "version": "1.1.2",
  "description": "Local-first perspective package analysis and editable 1:1 dieline generation.",
  "author": "S. M. Monowar Kayser",
  "license": "MIT",
  "homepage": "https://monokayser.github.io/perspective-dieline-generator/",
  "repository": "github:Monokayser/perspective-dieline-generator",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.web.config.ts",
    "build": "vite build --config vite.web.config.ts",
    "start": "vite preview --config vite.web.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:web": "npm run build && node --test tests/*.test.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "tauri": "tauri",
    "desktop:web": "vite build --config vite.desktop.config.ts",
    "desktop:serve": "vite --config vite.desktop.config.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "release:windows": "powershell -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "release:signed": "powershell -ExecutionPolicy Bypass -File scripts/build-signed-windows.ps1",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run lint && tsc --noEmit && npm test && npm run test:web",
    "audit:release": "npm audit --audit-level=low"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.52.0",
    "globals": "^17.4.0",
    "vite": "8.1.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "type": "module"
}
